<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Desktop Windows only. UWP/AppContainer requires a WinRT transport. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>HAVE_SSL;HAVE_SCHANNEL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>Secur32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
